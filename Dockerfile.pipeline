# Dockerfile cho Prefect Pipeline (chay scheduled tren VPS)
# Build: docker build -f Dockerfile.pipeline -t mlops-pipeline .
# Run:   docker run -d --name mlops-pipeline --restart=always mlops-pipeline

FROM python:3.10-slim

WORKDIR /app

# Cai system dependencies cho TensorFlow
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl && \
    rm -rf /var/lib/apt/lists/*

# Cai Python dependencies
COPY requirement.txt .
RUN pip install --no-cache-dir -r requirement.txt

# Copy toan bo project
COPY src/ src/
COPY models/ models/
COPY data/ data/
COPY dvc.yaml dvc.lock ./

# Prefect pipeline chay lien tuc voi cron schedule
CMD ["python", "-m", "src.pipeline.main_flow"]
