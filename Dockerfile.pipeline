# Dockerfile cho Prefect Pipeline (chạy scheduled trên VPS)
# Build: docker build -f Dockerfile.pipeline -t mlops-pipeline .
# Run:   docker run -d --name mlops-pipeline --restart=always mlops-pipeline

FROM python:3.10-slim

WORKDIR /app

# Cài system dependencies cho TensorFlow
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl && \
    rm -rf /var/lib/apt/lists/*

# Cài Python dependencies
COPY requirement.txt .
RUN pip install --no-cache-dir -r requirement.txt

# Copy toàn bộ project
COPY src/ src/
COPY flows/ flows/
COPY models/ models/
COPY data/ data/
COPY dvc.yaml dvc.lock ./

# Prefect pipeline chạy liên tục với cron schedule
CMD ["python", "flows/main_flow.py"]
