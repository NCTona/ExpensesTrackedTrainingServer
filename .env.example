PYTHONPATH=.

# API key xac thuc voi Spring Boot backend (/api/internal/*)
# Phai trung voi MLOPS_API_KEY trong .env cua BackEndAppMoney
MLOPS_API_KEY=your_strong_random_api_key

# Base URL cua backend (mac dinh https://localhost:8080)
MLOPS_BACKEND_URL=https://localhost:8080

# SSL verification: true / false / duong dan toi CA cert (.pem)
# Neu backend dung self-signed cert, tro toi file cert public cua server
MLOPS_SSL_VERIFY=certs/server_cert.pem
